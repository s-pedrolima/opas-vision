    {
        "id": "f708d0d3941c9f13",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Payload to String",
        "func": "function getState(num) {\n    switch (num) {\n        case 0: return \"⏳ WAITING FOR NEW PIECE\";\n        case 1: return \"⚙️ PREPARING TO WELD\";\n        case 2: return \"🔥 WELDING\";\n        case 3: return \"⚙️ FINISHING PROCESS\";\n        case 4: {\n            n++; \n            return \"✔️ PIECE RELEASED\";    \n        }\n        default: return \"ERROR\";\n    }\n}\n\nvar n = flow.get(\"pieces_welded\") || 0;\nmsg.payload = getState(msg.payload[0]);\nif(n !== flow.get(\"pieces_welded\")) {\n    flow.set(\"pieces_welded\", n);\n}\nmsg.count = n;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 80,
        "wires": [
            [
                "328cd8a892fe6d53"
            ]
        ],
        "icon": "font-awesome/fa-strikethrough"
    },
    {
        "id": "328cd8a892fe6d53",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "0356c747f1a2f24e",
        "page": "",
        "ui": "",
        "name": "State Display",
        "order": 2,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"state-container\">\n    <div class=\"machine-state\">\n      <span class=\"label\">Machine State:</span>\n      <span class=\"state\" :class=\"stateClass\">{{ msg.payload }}</span>\n    </div>\n\n    <div class=\"counting-pieces\">\n      <span class=\"count-label\">Welded Pieces:</span>\n      <span class=\"count-value\">{{ msg.count }}</span>\n    </div>\n  </div>\n</template>\n\n<script>\n  export default {\n  props: [\"msg\"],\n  computed: {\n    stateClass() {\n      const s = (this.msg?.payload || \"\").toUpperCase();\n      if (s.includes(\"WELDING\")) return \"welding\";\n      if (s.includes(\"RELEASED\")) return \"released\";\n      if (s.includes(\"ERROR\")) return \"error\";\n      return \"other\";\n    }\n  }\n}\n</script>\n\n<style scoped>\n\n  .state-container {\n    position: relative;\n    width: 100%;\n    height: 60px;\n    padding: 6px 12px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n\n  .machine-state {\n    font-size: 1rem;\n    font-weight: 600;\n    display: flex;\n    align-items: center;\n  }\n\n  .counting-pieces {\n    margin-top: 4px;\n    font-size: 0.95rem;\n    font-weight: 600;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .label,\n  .count-label {\n    color: #000;\n    margin-right: 6px;\n  }\n\n  .count-value {\n    font-weight: 700;\n    padding: 2px 6px;\n    border-radius: 6px;\n    background: #eaeaea;\n    transition: background 0.4s, transform 0.4s;\n  }\n\n  .count-value:not(:empty) {\n    background: linear-gradient(90deg, #4CAF50, #2ECC71);\n    color: white;\n    transform: scale(1.05);\n  }\n\n  .state.released {\n    background: linear-gradient(90deg, #2ecc71, #27ae60);\n    background-clip: text;\n    -webkit-background-clip: text;\n    color: transparent;\n  }\n\n  .state.welding {\n    background: linear-gradient(90deg, #e74c3c, #f39c12, #e74c3c);\n    background-size: 200% 200%;\n    background-clip: text;\n    -webkit-background-clip: text;\n    color: transparent;\n    animation: weld 2s linear infinite;\n  }\n\n  @keyframes weld {\n    0% {\n      background-position: 200% 0;\n    }\n\n    100% {\n      background-position: -200% 0;\n    }\n  }\n\n  .state.error {\n    color: #e74c3c !important;\n    background: none !important;\n    text-shadow: 0px 0px 6px rgba(231, 76, 60, 0.4);\n  }\n\n  .state.other {\n    background: linear-gradient(90deg, #888, #555, #888);\n    background-size: 200% 200%;\n    background-clip: text;\n    -webkit-background-clip: text;\n    color: transparent;\n    animation: shift 2.5s linear infinite;\n  }\n\n  @keyframes shift {\n    0% {\n      background-position: 200% 0;\n    }\n\n    100% {\n      background-position: -200% 0;\n    }\n  }\n</style>",
        "storeOutMessages": true,
