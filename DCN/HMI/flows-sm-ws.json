    {
        "id": "333cbe4b78b7e831",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "OPCUA Status",
        "func": "let status = msg.status;\nmsg = {};\nmsg.topic = \"OPCUA_Status\";\nlet alert_list = flow.get(\"Alert_List\") || [];\n\nswitch (status) {\n    case \"session active\":\n    case \"connected\":\n        if (alert_list.includes(\"OPCUA_Status\")) {\n            let i = alert_list.indexOf(\"OPCUA_Status\");\n            alert_list.splice(i, 1);\n            flow.set(\"Alert_List\", alert_list);\n        }\n        flow.set(\"OPCUA_Status\", true);\n        msg.payload = true;\n        return msg;\n\n    case \"reconnect\":\n    case \"disconnected\":\n        flow.set(\"OPCUA_Status\", false);\n        msg.payload = false;\n        return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Reset\nflow.set(\"OPCUA_Status\", false);",
