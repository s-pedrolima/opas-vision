    {
        "id": "86bf75b28f42651e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "OPCUA Data Constructor",
        "func": "let DCN = env.get(\"DCN_ID\") || \"unknown\";\nif (DCN === \"unknown\") return null; \nconst dir = \"ns=2;s=\";\n\nif(msg.payload.length === 1) {\n    return {\n        payload: msg.payload[0],\n        topic: `${dir}${DCN}/Machine_State`,\n        datatype: \"Int16\"\n    };\n}\n\nconst opcuaData = [\n    \"Conveyor\",\n    \"Base_Up\",\n    \"Base_Rotate\",\n    \"Base_Down\",\n    \"Shield_Down\",\n    \"Shield_Up\",\n    \"Burner\",\n    \"Piece_Pos_Sensor\",\n    \"Base_Up_Sensor\",\n    \"Base_Down_Sensor\",\n    \"Shield_Down_Sensor\",\n    \"Shield_Up_Sensor\"\n];\n\nconst newmsg = [];\nfor (let i = 0; i < opcuaData.length; i++) {\n    newmsg.push({\n        payload: msg.payload[i],\n        topic: `${dir}${DCN}/${opcuaData[i]}`,\n        datatype: \"Boolean\"\n    });\n}\nreturn [newmsg]; ",
