    {
        "id": "58b9eff72e8be032",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "0356c747f1a2f24e",
        "page": "",
        "ui": "",
        "name": "Actuators/Sensors",
        "order": 3,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"indicator-grid\">\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Conveyor_Run ? 'green darken-1' : 'grey'\"\n        :class=\"{ 'spin-animation': coils.Conveyor_Run }\">\n        mdi-cog\n      </v-icon>\n      <span class=\"name\">Conveyor</span>\n      <span class=\"status\" :class=\"{ 'active': coils.Conveyor_Run }\">\n        {{ coils.Conveyor_Run ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon v-if=\"coils.Base_Up\" size=\"48\" color=\"green darken-1\">mdi-arrow-up-bold-circle</v-icon>\n      <v-icon v-else-if=\"coils.Base_Down\" size=\"48\" color=\"green darken-1\">mdi-arrow-down-bold-circle</v-icon>\n      <v-icon v-else size=\"48\" color=\"grey\">mdi-stop-circle-outline</v-icon>\n\n      <span class=\"name\">Work Base</span>\n      <span class=\"status\" :class=\"baseStatusClass\">\n        {{ baseStatusText }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Base_Rotate ? 'green darken-1' : 'grey'\"\n        :class=\"{ 'spin-animation': coils.Base_Rotate }\">\n        mdi-cog\n      </v-icon>\n      <span class=\"name\">Base Rotation</span>\n      <span class=\"status\" :class=\"{ 'active': coils.Base_Rotate }\">\n        {{ coils.Base_Rotate ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon v-if=\"coils.Shield_Up\" size=\"48\" color=\"green darken-1\">mdi-arrow-up-bold-circle</v-icon>\n      <v-icon v-else-if=\"coils.Shield_Down\" size=\"48\" color=\"green darken-1\">mdi-arrow-down-bold-circle</v-icon>\n      <v-icon v-else size=\"48\" color=\"grey\">mdi-stop-circle-outline</v-icon>\n\n      <span class=\"name\">Suction Shield</span>\n      <span class=\"status\" :class=\"shieldStatusClass\">\n        {{ shieldStatusText }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Burner ? 'orange darken-2' : 'grey'\" :class=\"{ 'flame-animation': coils.Burner }\">\n        mdi-fire\n      </v-icon>\n      <span class=\"name\">Burner</span>\n      <span class=\"status\" :class=\"{ 'active': coils.Burner }\">\n        {{ coils.Burner ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n    <div class=\"separator\"></div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Base_Up_Sensor ? 'red' : 'grey'\" :class=\"{ 'sensor-glow': coils.Base_Up_Sensor }\">\n        mdi-access-point\n      </v-icon>\n      <span class=\"name\">Workbase Top Sensor</span>\n      <span class=\"status\" :class=\"{ 'active-sensor': coils.Base_Up_Sensor }\">\n        {{ coils.Base_Up_Sensor ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Base_Down_Sensor ? 'red' : 'grey'\"\n        :class=\"{ 'sensor-glow': coils.Base_Down_Sensor }\">\n        mdi-access-point\n      </v-icon>\n      <span class=\"name\">Workbase Bottom Sensor</span>\n      <span class=\"status\" :class=\"{ 'active-sensor': coils.Base_Down_Sensor }\">\n        {{ coils.Base_Down_Sensor ? 'ON' : 'OFF' }}\n      </span>\n\n    </div>\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Piece_Pos_Sensor ? 'red' : 'grey'\"\n        :class=\"{ 'sensor-glow': coils.Piece_Pos_Sensor }\">\n        mdi-access-point\n      </v-icon>\n      <span class=\"name\">Piece Sensor</span>\n      <span class=\"status\" :class=\"{ 'active-sensor': coils.Piece_Pos_Sensor }\">\n              {{ coils.Piece_Pos_Sensor ? 'ON' : 'OFF' }}\n        </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Shield_Down_Sensor ? 'red' : 'grey'\"\n        :class=\"{ 'sensor-glow': coils.Shield_Down_Sensor }\">\n        mdi-access-point\n      </v-icon>\n      <span class=\"name\">Shield Bottom Sensor</span>\n      <span class=\"status\" :class=\"{ 'active-sensor': coils.Shield_Down_Sensor }\">\n        {{ coils.Shield_Down_Sensor ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n    <div class=\"indicator-block\">\n      <v-icon size=\"48\" :color=\"coils.Shield_Up_Sensor ? 'red' : 'grey'\"\n        :class=\"{ 'sensor-glow': coils.Shield_Up_Sensor }\">\n        mdi-access-point\n      </v-icon>\n      <span class=\"name\">Shield Top Sensor</span>\n      <span class=\"status\" :class=\"{ 'active-sensor': coils.Shield_Up_Sensor }\">\n        {{ coils.Shield_Up_Sensor ? 'ON' : 'OFF' }}\n      </span>\n    </div>\n\n  </div>\n</template>\n\n<script>\n  export default {\n    props: ['msg'],\n    computed: {\n      coils() {\n        // Default object to prevent 'undefined' errors\n        const defaults = {\n          Conveyor_Run: false, Base_Up: false, Base_Rotate: false,\n          Base_Down: false, Shield_Down: false, Shield_Up: false,\n          Burner: false, Piece_Pos_Sensor: false, Base_Up_Sensor: false,\n          Base_Down_Sensor: false, Shield_Down_Sensor: false, Shield_Up_Sensor: false\n        };\n        return { ...defaults, ...this.msg?.payload };\n      },\n      \n      // --- Logic for Grouped Block: BASE ---\n      baseStatusText() {\n        if (this.coils.Base_Up) return 'MOVING UP';\n        if (this.coils.Base_Down) return 'MOVING DOWN';\n        return 'STOPPED';\n      },\n      baseStatusClass() {\n        // 'active' class for the green text\n        return (this.coils.Base_Up || this.coils.Base_Down) ? 'active' : '';\n      },\n\n      // --- Logic for Grouped Block: SHIELD ---\n      shieldStatusText() {\n        if (this.coils.Shield_Up) return 'MOVING UP';\n        if (this.coils.Shield_Down) return 'MOVING DOWN';\n        return 'STOPPED';\n      },\n      shieldStatusClass() {\n        return (this.coils.Shield_Up || this.coils.Shield_Down) ? 'active' : '';\n      }\n    }\n  }\n</script>\n\n<style>\n  /* --- The Main Grid (5 columns) --- */\n  .indicator-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 12px;\n    width: 100%;\n    height: 100%;\n    padding: 12px;\n    background-color: #f0f2f5;\n    box-sizing: border-box;\n  }\n\n  /* --- The Individual Block --- */\n  .indicator-block {\n    background: #ffffff;\n    border-radius: 8px;\n    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);\n    padding-top: 10px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    /* Center everything */\n    min-height: 140px;\n    border: 1px solid #e0e0e0;\n  }\n\n  /* Center icon and give space */\n  .v-icon {\n    margin-bottom: 8px;\n  }\n\n  /* --- The Separator --- */\n  .separator {\n    grid-column: 1 / -1;\n    height: 1px;\n    background-color: #d0d0d0;\n    margin: 5px 0;\n  }\n\n  /* --- Animations --- */\n\n  /* 1. Spin Animation (Gear) */\n  .spin-animation {\n    animation: spin 2s linear infinite;\n  }\n\n  @keyframes spin {\n    from {\n      transform: rotate(0deg);\n    }\n\n    to {\n      transform: rotate(360deg);\n    }\n  }\n\n  /* 2. Flame Animation (Burner) */\n  .flame-animation {\n    animation: flameWobble 0.5s linear infinite;\n  }\n\n  @keyframes flameWobble {\n\n    0%,\n    100% {\n      transform: scale(1.0, 1.0);\n    }\n\n    50% {\n      transform: scale(0.9, 1.1) translateY(2px);\n    }\n  }\n\n  /* 3. Sensor Glow (Red) */\n  .sensor-glow {\n    text-shadow: 0 0 12px rgba(231, 76, 60, 0.9);\n  }\n\n  /* --- Text (Name and Status) --- */\n  .name {\n    font-size: 0.9rem;\n    font-weight: 600;\n    color: #333;\n    text-align: center;\n    line-height: 1.2;\n  }\n\n  .status {\n    font-size: 0.8rem;\n    font-weight: 600;\n    padding: 2px 8px;\n    border-radius: 4px;\n    margin-top: 8px;\n    color: #333;\n    /* Status OFF (Grey) */\n    background: #f0f0f0;\n  }\n\n  .status.active {\n    color: #27ae60;\n    /* Status ON (Green) */\n    background: #e8f5e9;\n  }\n\n  /* Special Status for Sensor (Red) */\n  .status.active-sensor {\n    color: #e74c3c;\n    /* Status ON (Red) */\n    background: #fbeee0;\n  }\n</style>",
