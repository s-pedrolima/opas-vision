    },
    {
        "id": "c3951f4f69b46c7a",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Refresh",
        "func": "msg = [\n    {\n        topic: \"OPCUA_Status\",\n        payload: flow.get(\"OPCUA_Status\")\n    },\n    {\n        topic: \"Modbus_Status\",\n        payload: flow.get(\"Modbus_Status\")\n    },\n    {\n        topic: \"writing\",\n        payload: flow.get(\"Write_Status\")\n    },\n    {\n        topic: \"polling\",\n        payload: flow.get(\"Read_Status\")\n    }\n];\n\nreturn [msg];",
        "outputs": 1,
