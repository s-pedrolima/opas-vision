    {
        "id": "8e0ec484242ab4e6",
        "type": "ui-template",
        "z": "f6f2187d.f17ca8",
        "group": "0356c747f1a2f24e",
        "page": "",
        "ui": "",
        "name": "Connection Display",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div>\n        <p>\n            Modbus TCP Client:\n            <span :style=\"{ color: modbusStatus ? 'green' : 'red' }\">\n        <strong>{{ modbusStatus ? 'Active' : 'Error'}}</strong>\n      </span>\n            <span v-if=\"modbusStatus\">\n        |\n        <span :style=\"{ color: readStatus ? 'green' : 'red' }\">\n          <strong>{{ readStatus ? 'Reading' : 'Error' }}</strong>\n        </span>\n            </span>\n\n        <p>OPC UA Client:\n            <span :style=\"{ color: opcuaStatus ? 'green' : 'red' }\">\n        <strong>{{ opcuaStatus ? 'Active' : 'Error'}}</strong>\n      </span>\n            <span v-if=\"opcuaStatus && readStatus\">\n        |\n        <span :style=\"{ color: writeStatus ? 'green' : 'red' }\">\n          <strong>{{ writeStatus ? 'Writing' : 'Error'}}</strong>\n        </span>\n            </span>\n        </p>\n    </div>\n</template>\n\n<script>\n    export default {\n  data() {\n    return {\n      modbusStatus: null,\n      opcuaStatus: null,\n      writeStatus: null,\n      readStatus: null\n    };\n  },\n  watch: {\n    msg: {\n      immediate: true,\n      handler(newMsg) {\n        switch (newMsg.topic) {\n          case \"Modbus_Status\":\n            this.modbusStatus = newMsg.payload;\n            break;\n          case \"OPCUA_Status\":\n            this.opcuaStatus = newMsg.payload;\n            break;\n          case \"polling\":\n            this.readStatus = newMsg.payload;\n            break;\n          case \"writing\":\n            this.writeStatus = newMsg.payload;\n        }\n      }\n    }\n  }\n};\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 430,
        "y": 440,
