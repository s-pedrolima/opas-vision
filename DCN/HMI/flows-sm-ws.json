    {
        "id": "e7274e6953b66447",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Read/Write Status",
        "func": "const status = msg.payload;\nconst operation = msg.topic;\nlet alert_list = flow.get(\"Alert_List\") || [];\n\nswitch (operation) {\n    case \"polling\":\n        if (alert_list.includes(\"polling\")) {\n            let i = alert_list.indexOf(\"polling\");\n            alert_list.splice(i, 1);\n            flow.set(\"Alert_List\", alert_list);\n        }\n        if (status) flow.set(\"Read_Status\", true);\n        else flow.set(\"Read_Status\", false);\n        break;\n\n    case \"writing\":\n        if (alert_list.includes(\"writing\")) {\n            let i = alert_list.indexOf(\"writing\");\n            alert_list.splice(i, 1);\n            flow.set(\"Alert_List\", alert_list);\n        }\n        if (status) flow.set(\"Write_Status\", true);\n        else flow.set(\"Write_Status\", false);\n\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Reset\nflow.set(\"Write_Status\", false);\nflow.set(\"Read_Status\", false);",
        "finalize": "",
        "libs": [],
        "x": 190,
        "y": 460,
        "wires": [
            [
                "8e0ec484242ab4e6"
            ]
        ],
