    {
        "id": "e881cc98fd6c64a4",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Modbus Status",
        "func": "let status = msg.status.text.split(\" \")[0];\nmsg = {};\nmsg.topic = \"Modbus_Status\";\nlet alert_list = flow.get(\"Alert_List\") || [];\n\nswitch (status) {\n    case \"active\":\n        if (flow.get(\"Modbus_Status\") === false) {\n            if (alert_list.includes(\"Modbus_Status\")) {\n                let i = alert_list.indexOf(\"Modbus_Status\");\n                alert_list.splice(i, 1);\n                flow.set(\"Alert_List\", alert_list);\n            }\n            flow.set(\"Modbus_Status\", true);\n            msg.payload = true;\n            return msg;\n        }\n        break;\n\n    case \"broken\":\n        flow.set(\"Modbus_Status\", false);\n        msg.payload = false;\n        return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Reset \nflow.set(\"Modbus_Status\", false);",
        "finalize": "",
        "libs": [],
        "x": 200,
        "y": 380,
