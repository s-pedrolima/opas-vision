    {
        "id": "def34571a6425e40",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Spam Wall",
        "func": "// If no error is detected, skip message\nif (msg.payload) return;\n\n// Prevents redundant alerts\nif (msg.topic === \"polling\" && !flow.get(\"Modbus_Status\"))\n    return null;\nif (msg.topic === \"writing\" && (!flow.get(\"OPCUA_Status\") || !flow.get(\"Read_Status\")))\n    return null;\n\n// Check for full crash\nif (!flow.get(\"OPCUA_Status\") && !flow.get(\"Modbus_Status\"))\n    msg.topic = \"Full_Operation_Error\";\n\n// Check for spam - Only alert if it's a new error\nlet alert_list = flow.get(\"Alert_List\");\n\nif (!alert_list.includes(msg.topic)) {\n    alert_list.push(msg.topic);\n    flow.set(\"Alert_List\", alert_list);\n    return msg;\n}\n\nreturn;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "flow.set(\"Alert_List\", []);",
        "finalize": "",
        "libs": [],
        "x": 190,
        "y": 700,
        "wires": [
            [
                "7c535823d0bab3a6"
            ]
        ],
        "icon": "font-awesome/fa-flag"
    },
    {
        "id": "7c535823d0bab3a6",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Write Log",
        "func": "let dcn = env.get(\"DCN_ID\") || \"unknown\";\nlet error = \"unknown\";\nlet action_msg = \"Please check connectivity and restart the DCN if necessary.\";\n\n// Checks error type\nswitch (msg.topic) {\n    case \"OPCUA_Status\":\n        error = \"OPC UA Server Communication\";\n        break;\n    case \"Modbus_Status\":\n        error = \"Modbus TCP Server Communication\";\n        break;\n    case \"polling\":\n        error = \"Modbus Read Operation\";\n        break;\n    case \"writing\":\n        error = \"OPC UA Write Operation\";\n        break;\n    case \"Full_Operation_Error\":\n        action_msg = action_msg + \"\\n\\n After fixing the issue, be sure to redeploy the flows.\";\n        if ((Date.now() - context.get(\"Init_Time\")) / 60000 > 15)\n            error = \"Complete Node\"\n        else\n            error = \"Node Initialization\";\n        break;\n    default:\n        error = \"Unknown\";\n}\n\n\n\n// Skips warning if no information can be provided\nif (error === \"unknown\" && dcn === \"unknown\") return null;\n\n// Email structure\nmsg.topic = `[ALERT] Error Detected on ${dcn}`;\nmsg.payload = `\n🚨 *ERROR* 🚨\n\nControl Node: ${dcn}\nIssue: ${error} Failure Detected!\nTimestamp: ${new Date().toLocaleString()}\n\nAction: ${action_msg}\n\n———————————————————————————————————————————————\nAutomated alert from Node-RED Monitoring System\n`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "context.set(\"Init_Time\", Date.now());",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 700,
        "wires": [
            [
                "b521f15d09c88b7e"
            ]
        ],
        "icon": "font-awesome/fa-file-text"
    },
