# Copie este arquivo para .env e preencha sua chave de API:
#   cp .env.example .env
#
# Exemplo usando Upstage (Solar Mini 4 — OpenAI-compatible):
LLM_API_KEY=coloque_sua_chave_aqui
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_MODEL=solar-mini-4

# Outros provedores compatíveis (basta trocar as 3 linhas acima):
#   Groq       -> LLM_BASE_URL=https://api.groq.com/openai/v1 | LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter -> LLM_BASE_URL=https://openrouter.ai/api/v1    | LLM_MODEL=...
#   Gemini     -> LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ | LLM_MODEL=gemini-2.5-flash
