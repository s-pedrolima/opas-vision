    {
        "id": "a4dfe2fd1033e4d5",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Payload to JSON",
        "func": "var coils = msg.payload;\n\nmsg.payload = {\n    \"Conveyor_Run\": coils[0],\n    \"Base_Up\": coils[1],\n    \"Base_Rotate\": coils[2],\n    \"Base_Down\": coils[3],\n    \"Shield_Down\": coils[4],\n    \"Shield_Up\": coils[5],\n    \"Burner\": coils[6],\n    \"Piece_Pos_Sensor\": coils[7],\n    \"Base_Up_Sensor\": coils[8],\n    \"Base_Down_Sensor\": coils[9],\n    \"Shield_Down_Sensor\": coils[10],\n    \"Shield_Up_Sensor\": coils[11]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 240,
